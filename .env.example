# Copy to .env and fill in the values. Never commit .env.

# Secret that signs and verifies every JWT. Any long random string, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# HS256 = one shared secret for signing and verifying. Leave as is.
JWT_ALGORITHM=HS256

# Lifetime of the demo tokens printed by: python -m app.features.feature_auth.cli
JWT_TTL_MINUTES=10080

# Which LLM answers: "fake" (echoes the question, no key), "openai" or "gemini".
LLM_PROVIDER=fake

# Only the key of the selected provider is needed.
# OpenAI: https://platform.openai.com/api-keys  (format sk-...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Gemini: https://aistudio.google.com/apikey  (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Step 2: ingestion ---------------------------------------------------------

# Markdown sources of the Northwind documents and the folder the PDFs are built into:
#   python -m app.features.feature_sample_docs.cli
DOCS_SRC_DIR=./docs_src
DOCS_DIR=./docs

# "sentence-transformers" = real local model (downloads ~130 MB once).
# "hashing" = instant word hashing, no download; fine for a first run and for tests.
# Changing it means deleting chroma_data/ and ingesting again (vector sizes differ).
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local Chroma folder and collection, filled by: python -m app.features.feature_ingest.cli
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=northwind_docs

# Chunking: words per chunk and words repeated from the previous chunk.
CHUNK_SIZE_WORDS=120
CHUNK_OVERLAP_WORDS=30

# EasyOCR languages for scanned pages, comma-separated (e.g. en,de).
OCR_LANGUAGES=en

# --- Step 3: retrieval -----------------------------------------------------------

# Allowed chunks retrieved per question (the user's access filter is applied inside the query).
RETRIEVAL_TOP_K=4

# --- Step 6: hardening ------------------------------------------------------------

# Longest question accepted, in characters.
MAX_MESSAGE_CHARS=2000
# Server log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
