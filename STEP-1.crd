      "owner": "core",
      "component_reason": "The single trust decision for tokens; shared in core/ because it is not owned by one feature.",
      "status": "observed",
      "inputs": [
        {
          "id": "in-token",
          "name": "token",
          "description": "str, required. Raw JWT from the auth message."
        },
