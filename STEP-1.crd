      "validations": [
        {
          "input": "in-auth",
          "rules": [
            "must parse as ClientMessage, else auth_failed + close",
            "type == \"auth\" and token present, else auth_failed + close",
            "verify_jwt must succeed, else auth_failed with the AuthError message + close"
          ]
