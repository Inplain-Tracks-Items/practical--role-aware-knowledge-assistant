      "id": "be.service_retrieve_chunks",
      "name": "service_retrieve_chunks",
      "kind": "function",
      "side": "backend",
      "layer": "service",
      "description": "Embeds the question and queries the vector store with the user's access filter inside the query.",
      "flows": [
        "chat-session"
      ],
      "source": {
        "file": "app/features/feature_chat/services/service_retrieve_chunks.py",
        "symbol": "app.features.feature_chat.services.service_retrieve_chunks.service_retrieve_chunks",
        "lines": [
          15,
          36
        ]
      },
      "owner": "feature_chat",
      "component_reason": "The access-aware search: the one place where identity meets the vector store.",
      "status": "observed",
      "inputs": [
        {
          "id": "in-question",
          "name": "question",
          "description": "str, required. The user's message."
        },
        {
          "id": "in-user",
          "name": "user",
          "description": "TokenClaims, required. Verified role and clearance."
        },
        {
          "id": "in-embedder",
          "name": "embedder",
          "description": "EmbeddingProvider, injected."
        },
        {
          "id": "in-store",
          "name": "store",
          "description": "VectorStore, injected."
        },
        {
          "id": "in-topk",
          "name": "top_k",
          "description": "int, required. settings.retrieval_top_k (default 4)."
        }
      ],
      "validations": [],
      "operations": [
        {
          "id": "op-filter",
          "title": "util_build_access_filter",
          "origin": "imported",
          "description": "Builds the where-filter from role and clearance. app/features/feature_chat/services/service_retrieve_chunks.py:31",
          "show": true,
          "calls": {
            "component": "be.util_build_access_filter",
            "type": "call",
            "label": "build access filter",
            "evidence": "app/features/feature_chat/services/service_retrieve_chunks.py:31  where = util_build_access_filter(user)"
          }
        },
        {
          "id": "op-embed",
          "title": "embedder.embed_query",
          "origin": "imported",
          "description": "Embeds the question (EMBEDDING_PROVIDER=sentence-transformers). app/features/feature_chat/services/service_retrieve_chunks.py:33",
          "show": true,
          "calls": {
            "component": "be.SentenceTransformersProvider.embed_query",
            "type": "await",
            "label": "embed query (sentence-transformers)",
            "evidence": "app/features/feature_chat/services/service_retrieve_chunks.py:33  embedding = await embedder.embed_query(question)"
          }
        },
        {
          "id": "op-embed-hashing",
          "title": "embedder.embed_query",
          "origin": "imported",
          "description": "Same call when EMBEDDING_PROVIDER=hashing. app/features/feature_chat/services/service_retrieve_chunks.py:33",
          "show": true,
          "calls": {
            "component": "be.HashingProvider.embed_query",
            "type": "await",
            "label": "embed query (hashing)",
            "evidence": "app/features/feature_chat/services/service_retrieve_chunks.py:33  embedding = await embedder.embed_query(question)"
          }
        },
        {
          "id": "op-query",
          "title": "store.query",
          "origin": "imported",
          "description": "Filtered similarity search; no Python post-filtering. app/features/feature_chat/services/service_retrieve_chunks.py:36",
          "show": true,
          "calls": {
            "component": "be.ChromaStore.query",
            "type": "await",
            "label": "filtered query",
            "evidence": "app/features/feature_chat/services/service_retrieve_chunks.py:36  return await store.query(embedding, top_k, where)"
          }
        }
      ],
      "outputs": [
        {
          "id": "out-chunks",
          "name": "list[RetrievedChunk]",
          "description": "text, source_file, page, distance; most relevant first; allowed chunks only."
        }
      ],
      "attributes": {
        "is_async": true,
        "validations_note": "no input checks in code"
      },
      "step_change": "unchanged"
    },
