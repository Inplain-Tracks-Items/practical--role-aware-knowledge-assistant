    {
      "id": "be.service_find_visible_shipment",
      "name": "service_find_visible_shipment",
      "kind": "function",
      "side": "backend",
      "layer": "service",
      "description": "Looks a shipment up only if visible: dispatcher/safety/leadership all, drivers their trips, sales their accounts.",
      "flows": [
        "shipment-lookup",
        "chat-session"
      ],
      "source": {
        "file": "app/features/feature_shipment_tool/services/service_find_visible_shipment.py",
        "symbol": "app.features.feature_shipment_tool.services.service_find_visible_shipment.service_find_visible_shipment",
        "lines": [
          15,
          34
        ]
      },
      "owner": "feature_shipment_tool",
      "component_reason": "The shipment access rule, applied in the lookup itself.",
      "status": "observed",
      "inputs": [
        {
          "id": "in-id",
          "name": "shipment_id",
          "description": "str. Normalised with strip().upper()."
        },
        {
          "id": "in-user",
          "name": "user",
          "description": "TokenClaims. role and sub."
        }
      ],
      "validations": [
        {
          "input": "in-user",
          "rules": [
            "driver: shipment.driver_id == user.sub",
            "sales: shipment.account_owner_id == user.sub",
            "dispatcher, safety, leadership: always",
            "otherwise None"
          ]
        }
      ],
      "operations": [
        {
          "id": "op-lookup",
          "title": "SHIPMENTS.get",
          "origin": "imported",
          "description": "Looks the id up in the mock register. app/features/feature_shipment_tool/services/service_find_visible_shipment.py:24",
          "show": true,
          "calls": {
            "component": "ext.operations_apis",
            "type": "await",
            "label": "planner lookup (mock)",
            "evidence": "app/features/feature_shipment_tool/services/service_find_visible_shipment.py:24  shipment = SHIPMENTS.get(shipment_id.strip().upper())"
          }
        },
        {
          "id": "op-rule",
          "title": "inline: visibility rule",
          "origin": "inline",
          "description": "Applies the role rule; same None for missing and forbidden. app/features/feature_shipment_tool/services/service_find_visible_shipment.py:27",
          "show": true,
          "calls": null
        },
        {
          "id": "op-use-shipments",
          "title": "SHIPMENTS",
          "origin": "imported",
          "description": "Calls SHIPMENTS (app.features.feature_shipment_tool.configs.shipments). app/features/feature_shipment_tool/services/service_find_visible_shipment.py:24",
          "show": true,
          "calls": {
            "component": "be.SHIPMENTS",
            "type": "call",
            "label": "calls SHIPMENTS",
            "evidence": "app/features/feature_shipment_tool/services/service_find_visible_shipment.py:24  shipment = SHIPMENTS.get(shipment_id.strip().upper())"
          }
        }
      ],
      "outputs": [
        {
          "id": "out-shipment",
          "name": "dict | None",
          "description": "The shipment record or None."
        }
      ],
      "attributes": {
        "is_async": true
      },
      "step_change": "added"
    },
