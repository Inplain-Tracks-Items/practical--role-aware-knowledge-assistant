      "id": "be.verify_jwt",
      "name": "verify_jwt",
      "kind": "function",
      "side": "backend",
      "layer": "service",
      "description": "Verifies a JWT's signature and expiry and validates its claims into TokenClaims.",
      "flows": [
        "chat-session"
      ],
      "source": {
        "file": "app/core/verify_jwt.py",
        "symbol": "app.core.verify_jwt.verify_jwt",
        "lines": [
          16,
          40
        ]
      },
      "owner": "core",
      "component_reason": "The single trust decision for tokens; shared in core/ because it is not owned by one feature.",
      "status": "observed",
      "inputs": [
        {
          "id": "in-token",
          "name": "token",
          "description": "str, required. Raw JWT from the auth message."
        },
        {
          "id": "in-settings",
          "name": "settings",
          "description": "Settings, required. jwt_secret and jwt_algorithm."
        }
      ],
      "validations": [
        {
          "input": "in-token",
          "rules": [
            "signature valid and algorithm in [jwt_algorithm], else AuthError(\"invalid token\")",
            "exp in the future, else AuthError(\"token expired\")",
            "claims match TokenClaims (role in Role, clearance in Clearance), else AuthError(\"token claims are incomplete or unknown\")"
          ]
        }
      ],
      "operations": [
        {
          "id": "op-decode",
          "title": "jwt.decode",
          "origin": "external",
          "description": "Checks signature and expiry with the pinned algorithm. app/core/verify_jwt.py:27",
          "show": true,
          "calls": {
            "component": "ext.pyjwt",
            "type": "call",
            "label": "verify",
            "evidence": "app/core/verify_jwt.py:27  payload = jwt.decode(token, settings.jwt_secret, algorithms=[settings.jwt_algorithm])"
          }
        },
        {
          "id": "op-claims",
          "title": "TokenClaims",
          "origin": "imported",
          "description": "Validates the payload into TokenClaims. app/core/verify_jwt.py:38",
          "show": true,
          "calls": {
            "component": "be.TokenClaims",
            "type": "call",
            "label": "calls TokenClaims",
            "evidence": "app/core/verify_jwt.py:38  return TokenClaims(**payload)"
          }
        },
        {
          "id": "op-use-autherror",
          "title": "AuthError",
          "origin": "imported",
          "description": "Calls AuthError (app.core.auth_error). app/core/verify_jwt.py:30",
          "show": true,
          "calls": {
            "component": "be.AuthError",
            "type": "call",
            "label": "calls AuthError",
            "evidence": "app/core/verify_jwt.py:30  raise AuthError(\"token expired\")"
          }
        }
      ],
      "outputs": [
        {
          "id": "out-claims",
          "name": "TokenClaims",
          "description": "sub, email, name, role, clearance."
        },
        {
          "id": "out-error",
          "name": "error.AuthError",
          "description": "\"token expired\", \"invalid token\" or \"token claims are incomplete or unknown\"."
        }
      ],
      "attributes": {
        "is_async": false
      },
      "step_change": "unchanged"
    },
