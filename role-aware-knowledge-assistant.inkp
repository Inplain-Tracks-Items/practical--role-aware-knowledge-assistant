          {
            "id": "op-claims",
            "title": "TokenClaims",
            "description": "Validates the payload into TokenClaims. app/core/verify_jwt.py:38\n→ call TokenClaims (calls TokenClaims)\nEvidence: app/core/verify_jwt.py:38  return TokenClaims(**payload)",
            "showInDiagram": true,
            "order_no": 2
          },
