      "path": "process_executor_canvas/crd-role-aware-knowledge-assistant-s4-be-verify-jwt",
      "data": {
        "name": "verify_jwt",
        "input": [
          {
            "id": "in-token",
            "name": "token",
            "description": "str, required. Raw JWT from the auth message.",
