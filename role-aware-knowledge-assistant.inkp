            "id": "val-in-dir",
            "inputId": "in-dir",
            "rules": [
              "each PDF must be a key of ACCESS_MAP, else it is skipped and reported (never stored)"
            ],
            "order_no": 1
          }
        ],
        "operation": [
          {
            "id": "op-list",
            "title": "service_list_pdfs",
            "description": "Lists *.pdf in docs_dir. app/features/feature_ingest/handlers/handle_ingest_documents.py:44\n→ await service_list_pdfs (list PDFs)\nEvidence: app/features/feature_ingest/handlers/handle_ingest_documents.py:44  for pdf in await service_list_pdfs(docs_dir):",
            "showInDiagram": true,
            "order_no": 1
          },
          {
            "id": "op-access",
            "title": "ACCESS_MAP.get",
            "description": "Looks up audience and clearance; None -> skipped. app/features/feature_ingest/handlers/handle_ingest_documents.py:46\n→ call ACCESS_MAP (calls ACCESS_MAP)\nEvidence: app/features/feature_ingest/handlers/handle_ingest_documents.py:46  access = ACCESS_MAP.get(pdf.name)",
            "showInDiagram": true,
            "order_no": 2
          },
          {
            "id": "op-extract",
            "title": "service_extract_pages",
            "description": "Page texts; scanned pages have needs_ocr=True. app/features/feature_ingest/handlers/handle_ingest_documents.py:51\n→ await service_extract_pages (extract pages)\nEvidence: app/features/feature_ingest/handlers/handle_ingest_documents.py:51  for page in await service_extract_pages(pdf):",
            "showInDiagram": true,
