          },
          {
            "id": "attr-owner",
            "key": "owner",
            "value": "feature_auth"
          },
          {
            "id": "attr-source_file",
            "key": "source_file",
            "value": "app/features/feature_auth/cli.py"
          },
          {
            "id": "attr-qualified_symbol",
            "key": "qualified_symbol",
            "value": "app.features.feature_auth.cli.main"
          },
          {
            "id": "attr-lines",
            "key": "lines",
            "value": "13-20"
          },
          {
            "id": "attr-component_reason",
            "key": "component_reason",
            "value": "Entry point of the token minting flow (python -m app.features.feature_auth.cli)."
          },
          {
            "id": "attr-status",
            "key": "status",
            "value": "observed"
          },
          {
            "id": "attr-step_change",
            "key": "step_change",
            "value": "added"
          },
          {
