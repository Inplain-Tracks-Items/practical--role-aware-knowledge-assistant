    {
      "path": "process_executor_canvas/crd-role-aware-knowledge-assistant-s1-be-service-mint-token",
      "data": {
        "name": "service_mint_token",
        "input": [
          {
            "id": "in-claims",
            "name": "claims",
            "description": "TokenClaims, required. sub, email, name, role, clearance.",
            "order_no": 1
          },
          {
            "id": "in-settings",
            "name": "settings",
            "description": "Settings, required. jwt_secret, jwt_algorithm, jwt_ttl_minutes.",
            "order_no": 2
          },
          {
            "id": "in-ttl",
            "name": "ttl_seconds",
            "description": "int | None, optional, default None (= jwt_ttl_minutes * 60). Negative values mint expired tokens for tests.",
            "order_no": 3
          }
        ],
        "validations": [],
        "operation": [
          {
            "id": "op-now",
            "title": "time.time",
            "description": "Current Unix time, used as iat. app/features/feature_auth/services/service_mint_token.py:24",
            "showInDiagram": true,
            "order_no": 1
          },
          {
            "id": "op-lifetime",
            "title": "inline: lifetime",
            "description": "ttl_seconds if given, else jwt_ttl_minutes * 60. app/features/feature_auth/services/service_mint_token.py:25",
            "showInDiagram": true,
            "order_no": 2
          },
          {
            "id": "op-payload",
            "title": "claims.model_dump",
            "description": "Claims as a dict plus iat and exp. app/features/feature_auth/services/service_mint_token.py:27",
            "showInDiagram": true,
            "order_no": 3
          },
          {
            "id": "op-encode",
            "title": "jwt.encode",
            "description": "Signs the payload with jwt_secret using jwt_algorithm. app/features/feature_auth/services/service_mint_token.py:28\n→ call PyJWT (sign)\nEvidence: app/features/feature_auth/services/service_mint_token.py:28  return jwt.encode(payload, settings.jwt_secret, algorithm=settings.jwt_algorithm)",
            "showInDiagram": true,
            "order_no": 4
          }
        ],
        "output": [
          {
            "id": "out-token",
            "name": "token",
            "description": "str. The signed JWT.",
            "order_no": 1
          }
        ],
        "attributes": [
          {
            "id": "attr-description",
            "key": "description",
