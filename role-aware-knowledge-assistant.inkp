            "description": "OcrProvider, injected.",
            "order_no": 6
          }
        ],
        "validations": [
          {
            "id": "val-in-dir",
            "inputId": "in-dir",
            "rules": [
              "each PDF must be a key of ACCESS_MAP, else it is skipped and reported (never stored)"
            ],
            "order_no": 1
          }
        ],
        "operation": [
          {
            "id": "op-list",
            "title": "service_list_pdfs",
            "description": "Lists *.pdf in docs_dir. app/features/feature_ingest/handlers/handle_ingest_documents.py:44\n→ await service_list_pdfs (list PDFs)\nEvidence: app/features/feature_ingest/handlers/handle_ingest_documents.py:44  for pdf in await service_list_pdfs(docs_dir):",
            "showInDiagram": true,
            "order_no": 1
          },
          {
