        "validations": [],
        "operation": [
          {
            "id": "op-retrieve",
            "title": "service_retrieve_chunks",
            "description": "Retrieves up to retrieval_top_k chunks the user may read. app/features/feature_chat/handlers/handle_chat_socket.py:144\n→ await service_retrieve_chunks (retrieve allowed chunks)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:144  chunks = await service_retrieve_chunks(text, user, embedder, store, settings.retrieval_top_k)",
            "showInDiagram": true,
            "order_no": 1
          },
          {
            "id": "op-sources",
            "title": "websocket.send_json",
            "description": "Sends a sources event with the deduplicated (file, page) pairs. app/features/feature_chat/handlers/handle_chat_socket.py:147",
            "showInDiagram": true,
            "order_no": 2
          },
          {
            "id": "op-prompt",
            "title": "service_build_prompt",
            "description": "Builds rules + labelled allowed passages. app/features/feature_chat/handlers/handle_chat_socket.py:149\n→ call service_build_prompt (build prompt)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:149  system_prompt = service_build_prompt(chunks)",
            "showInDiagram": true,
            "order_no": 3
          },
          {
            "id": "op-answer",
            "title": "service_stream_answer",
            "description": "Streams the LLM answer with the bound tools. app/features/feature_chat/handlers/handle_chat_socket.py:151\n→ await service_stream_answer (stream answer (with tools))\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:151  async for piece in service_stream_answer(system_prompt, text, llm, tools):",
            "showInDiagram": true,
            "order_no": 4
          },
          {
            "id": "op-stream",
            "title": "websocket.send_json",
            "description": "Sends each piece as a stream event. app/features/feature_chat/handlers/handle_chat_socket.py:152",
            "showInDiagram": true,
            "order_no": 5
          },
          {
            "id": "op-done",
            "title": "websocket.send_json",
            "description": "Sends done after the last piece. app/features/feature_chat/handlers/handle_chat_socket.py:153",
            "showInDiagram": true,
            "order_no": 6
          },
          {
            "id": "op-use-sourcesevent",
            "title": "SourcesEvent",
            "description": "Calls SourcesEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:147\n→ call SourcesEvent (calls SourcesEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:147  await websocket.send_json(SourcesEvent(sources=[SourceRef(source_file=f, page=p) for f, p in pages]).model_dump())",
            "showInDiagram": true,
            "order_no": 7
          },
          {
            "id": "op-use-sourceref",
            "title": "SourceRef",
            "description": "Calls SourceRef (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:147\n→ call SourceRef (calls SourceRef)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:147  await websocket.send_json(SourcesEvent(sources=[SourceRef(source_file=f, page=p) for f, p in pages]).model_dump())",
            "showInDiagram": true,
            "order_no": 8
          },
          {
            "id": "op-use-streamevent",
            "title": "StreamEvent",
            "description": "Calls StreamEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:152\n→ call StreamEvent (calls StreamEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:152  await websocket.send_json(StreamEvent(text=piece).model_dump())",
            "showInDiagram": true,
            "order_no": 9
          },
          {
            "id": "op-use-doneevent",
            "title": "DoneEvent",
            "description": "Calls DoneEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:153\n→ call DoneEvent (calls DoneEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:153  await websocket.send_json(DoneEvent().model_dump())",
            "showInDiagram": true,
            "order_no": 10
          }
        ],
        "output": [
