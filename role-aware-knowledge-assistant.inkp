    {
      "path": "process_executor_canvas/crd-role-aware-knowledge-assistant-s1-be-auth-cli",
      "data": {
        "name": "main",
        "input": [
          {
            "id": "in-settings",
            "name": "settings",
            "description": "Settings, from get_settings() (reads JWT_SECRET from .env).",
            "order_no": 1
          }
        ],
        "validations": [],
        "operation": [
          {
            "id": "op-settings",
            "title": "get_settings",
            "description": "Loads the cached Settings. app/features/feature_auth/cli.py:16",
            "showInDiagram": true,
            "order_no": 1
          },
          {
            "id": "op-mint",
            "title": "handle_mint_demo_tokens",
            "description": "Mints one token per demo user; iterates the returned entries. app/features/feature_auth/cli.py:16\n→ call handle_mint_demo_tokens (mint all demo tokens)\nEvidence: app/features/feature_auth/cli.py:16  for entry in handle_mint_demo_tokens(get_settings()):",
            "showInDiagram": true,
            "order_no": 2
          },
          {
            "id": "op-print",
            "title": "print",
            "description": "Prints name, email, role, clearance and the token for each entry. app/features/feature_auth/cli.py:19",
            "showInDiagram": true,
            "order_no": 3
          }
        ],
        "output": [
          {
            "id": "out-stdout",
            "name": "stdout",
            "description": "One header line and one JWT per demo user. The secret is never printed.",
            "order_no": 1
          }
        ],
        "attributes": [
          {
            "id": "attr-description",
            "key": "description",
            "value": "CLI door: prints a signed JWT for every demo user, with role and clearance."
          },
          {
            "id": "attr-crd_id",
            "key": "crd_id",
            "value": "be.auth_cli"
          },
          {
            "id": "attr-kind",
            "key": "kind",
            "value": "function"
          },
          {
            "id": "attr-side",
            "key": "side",
            "value": "backend"
          },
          {
            "id": "attr-layer",
            "key": "layer",
