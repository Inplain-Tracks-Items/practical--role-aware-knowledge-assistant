    {
      "path": "process_executor_canvas/crd-role-aware-knowledge-assistant-s6-be-handle-chat-socket",
      "data": {
        "name": "handle_chat_socket",
        "input": [
          {
            "id": "in-ws",
            "name": "websocket",
            "description": "WebSocket, from the door.",
            "order_no": 1
          },
          {
            "id": "in-settings",
            "name": "settings",
            "description": "Settings, from the door. JWT verification and retrieval_top_k.",
            "order_no": 2
          },
          {
            "id": "in-llm",
            "name": "llm",
            "description": "LLMProvider, from the door.",
            "order_no": 3
          },
          {
            "id": "in-embedder",
            "name": "embedder",
            "description": "EmbeddingProvider, from the door.",
            "order_no": 4
          },
          {
            "id": "in-store",
            "name": "store",
            "description": "VectorStore, from the door.",
            "order_no": 5
          },
          {
            "id": "in-auth",
            "name": "message.auth",
            "description": "First client message {type: \"auth\", token}.",
            "order_no": 6
          },
          {
            "id": "in-msg",
            "name": "message.question",
            "description": "Later client messages {type: \"message\", text}.",
            "order_no": 7
          }
        ],
        "validations": [
          {
            "id": "val-in-auth",
            "inputId": "in-auth",
            "rules": [
              "must parse as ClientMessage, else auth_failed + close",
              "type == \"auth\" and token present, else auth_failed + close",
              "verify_jwt must succeed, else auth_failed with the AuthError message + close (logged)"
            ],
            "order_no": 1
          },
          {
            "id": "val-in-msg",
            "inputId": "in-msg",
            "rules": [
              "must parse as ClientMessage, else error \"invalid message\" and the loop continues",
              "type == \"message\" and text not empty, else ignored",
              "len(text) <= settings.max_message_chars, else error \"message too long\" and no model call"
            ],
            "order_no": 2
          }
        ],
        "operation": [
          {
            "id": "op-accept",
            "title": "websocket.accept",
            "description": "Accepts the connection. app/features/feature_chat/handlers/handle_chat_socket.py:61",
            "showInDiagram": true,
            "order_no": 1
          },
          {
            "id": "op-recv-auth",
            "title": "websocket.receive_json",
            "description": "Reads the first message and parses it as ClientMessage. app/features/feature_chat/handlers/handle_chat_socket.py:65",
            "showInDiagram": true,
            "order_no": 2
          },
          {
            "id": "op-verify",
            "title": "verify_jwt",
            "description": "Verifies the token; the returned TokenClaims are the connection's identity. app/features/feature_chat/handlers/handle_chat_socket.py:81\n→ call verify_jwt (verify token)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:81  user = verify_jwt(first.token, settings)",
            "showInDiagram": true,
            "order_no": 3
          },
          {
            "id": "op-log-auth",
            "title": "logger.info",
            "description": "Logs a refused login with its reason (never the token). app/features/feature_chat/handlers/handle_chat_socket.py:84",
            "showInDiagram": true,
            "order_no": 4
          },
          {
            "id": "op-auth-ok",
            "title": "websocket.send_json",
            "description": "Sends auth_success with user_id, name, role, clearance. app/features/feature_chat/handlers/handle_chat_socket.py:90",
            "showInDiagram": true,
            "order_no": 5
          },
          {
            "id": "op-bind",
            "title": "tool_bind_shipment_overview",
            "description": "Binds the shipment tool to this connection's user, once. app/features/feature_chat/handlers/handle_chat_socket.py:95\n→ call tool_bind_shipment_overview (bind tool to user)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:95  tools = [tool_bind_shipment_overview(user)]",
            "showInDiagram": true,
            "order_no": 6
          },
          {
            "id": "op-recv",
            "title": "websocket.receive_json",
            "description": "Loop: reads the next message; malformed ones get \"invalid message\". app/features/feature_chat/handlers/handle_chat_socket.py:101",
            "showInDiagram": true,
            "order_no": 7
          },
          {
            "id": "op-length",
            "title": "inline: length check",
            "description": "Refuses text longer than max_message_chars with an error event. app/features/feature_chat/handlers/handle_chat_socket.py:113",
            "showInDiagram": true,
            "order_no": 8
          },
          {
            "id": "op-answer",
            "title": "_answer",
            "description": "Answers the question (sources, streamed answer, done). app/features/feature_chat/handlers/handle_chat_socket.py:117\n→ await _answer (answer one question)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:117  await _answer(websocket, message.text, user, settings, llm, embedder, store, tools)",
            "showInDiagram": true,
            "order_no": 9
          },
          {
            "id": "op-fail",
            "title": "logger.exception + send_json",
            "description": "On any exception from _answer: logs the stack trace and sends error ANSWER_FAILED; the loop continues. app/features/feature_chat/handlers/handle_chat_socket.py:124",
            "showInDiagram": true,
            "order_no": 10
          },
          {
            "id": "op-use-clientmessage",
            "title": "ClientMessage",
            "description": "Calls ClientMessage (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:65\n→ call ClientMessage (calls ClientMessage)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:65  first = ClientMessage(**await websocket.receive_json())",
            "showInDiagram": true,
            "order_no": 11
          },
          {
            "id": "op-use-authfailedevent",
            "title": "AuthFailedEvent",
            "description": "Calls AuthFailedEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:71\n→ call AuthFailedEvent (calls AuthFailedEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:71  await websocket.send_json(AuthFailedEvent(message=\"first message must be an auth message\").model_dump())",
            "showInDiagram": true,
            "order_no": 12
          },
          {
            "id": "op-use-authsuccessevent",
            "title": "AuthSuccessEvent",
            "description": "Calls AuthSuccessEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:90\n→ call AuthSuccessEvent (calls AuthSuccessEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:90  AuthSuccessEvent(user_id=user.sub, name=user.name, role=user.role, clearance=user.clearance).model_dump()",
            "showInDiagram": true,
            "order_no": 13
          },
          {
            "id": "op-use-errorevent",
            "title": "ErrorEvent",
            "description": "Calls ErrorEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:107\n→ call ErrorEvent (calls ErrorEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:107  await websocket.send_json(ErrorEvent(message=\"invalid message\").model_dump())",
            "showInDiagram": true,
            "order_no": 14
          }
        ],
        "output": [
          {
            "id": "out-auth-success",
            "name": "event.auth_success",
            "description": "{type, user_id, name, role, clearance}.",
            "order_no": 1
          },
          {
            "id": "out-auth-failed",
            "name": "event.auth_failed",
            "description": "{type, message}; the socket is closed afterwards.",
            "order_no": 2
          },
          {
            "id": "out-sources",
            "name": "event.sources",
            "description": "From _answer.",
            "order_no": 3
          },
          {
            "id": "out-stream",
            "name": "event.stream",
            "description": "From _answer.",
            "order_no": 4
          },
          {
            "id": "out-done",
            "name": "event.done",
            "description": "From _answer.",
            "order_no": 5
          },
          {
            "id": "out-error",
            "name": "event.error",
            "description": "\"invalid message\", \"message too long (max N characters)\" or ANSWER_FAILED; the connection stays open.",
            "order_no": 6
          }
        ],
        "attributes": [
          {
            "id": "attr-description",
            "key": "description",
            "value": "Runs one chat connection: accept, auth handshake, binds the user's tools, then a loop that validates each message and answers it through _answer, turning any failure into an error event."
          },
          {
            "id": "attr-crd_id",
            "key": "crd_id",
            "value": "be.handle_chat_socket"
          },
          {
            "id": "attr-kind",
            "key": "kind",
            "value": "function"
          },
          {
            "id": "attr-side",
            "key": "side",
            "value": "backend"
          },
          {
            "id": "attr-layer",
            "key": "layer",
            "value": "handler"
          },
          {
