    {
      "path": "process_executor_canvas/crd-role-aware-knowledge-assistant-s5-be-handle-chat-socket",
      "data": {
        "name": "handle_chat_socket",
        "input": [
          {
            "id": "in-ws",
            "name": "websocket",
            "description": "WebSocket, from the door.",
            "order_no": 1
          },
          {
            "id": "in-settings",
            "name": "settings",
            "description": "Settings, from the door. JWT verification and retrieval_top_k.",
            "order_no": 2
          },
          {
            "id": "in-llm",
            "name": "llm",
            "description": "LLMProvider, from the door.",
            "order_no": 3
          },
          {
            "id": "in-embedder",
            "name": "embedder",
            "description": "EmbeddingProvider, from the door.",
            "order_no": 4
          },
          {
            "id": "in-store",
            "name": "store",
            "description": "VectorStore, from the door.",
            "order_no": 5
          },
          {
            "id": "in-auth",
            "name": "message.auth",
            "description": "First client message {type: \"auth\", token}.",
            "order_no": 6
          },
          {
            "id": "in-msg",
            "name": "message.question",
            "description": "Later client messages {type: \"message\", text}.",
            "order_no": 7
          }
        ],
        "validations": [
          {
            "id": "val-in-auth",
            "inputId": "in-auth",
            "rules": [
              "must parse as ClientMessage, else auth_failed + close",
              "type == \"auth\" and token present, else auth_failed + close",
              "verify_jwt must succeed, else auth_failed with the AuthError message + close"
            ],
            "order_no": 1
          },
          {
            "id": "val-in-msg",
            "inputId": "in-msg",
            "rules": [
              "must parse as ClientMessage, else error event \"invalid message\" and the loop continues",
              "type == \"message\" and text not empty, else ignored"
            ],
            "order_no": 2
          }
        ],
        "operation": [
          {
            "id": "op-accept",
            "title": "websocket.accept",
            "description": "Accepts the connection. app/features/feature_chat/handlers/handle_chat_socket.py:50",
            "showInDiagram": true,
            "order_no": 1
          },
          {
            "id": "op-recv-auth",
            "title": "websocket.receive_json",
            "description": "Reads the first message and parses it as ClientMessage. app/features/feature_chat/handlers/handle_chat_socket.py:54",
            "showInDiagram": true,
            "order_no": 2
          },
          {
            "id": "op-verify",
            "title": "verify_jwt",
            "description": "Verifies the token; the returned TokenClaims are the connection's identity. app/features/feature_chat/handlers/handle_chat_socket.py:70\n→ call verify_jwt (verify token)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:70  user = verify_jwt(first.token, settings)",
            "showInDiagram": true,
            "order_no": 3
          },
          {
            "id": "op-auth-ok",
            "title": "websocket.send_json",
            "description": "Sends auth_success with user_id, name, role, clearance. app/features/feature_chat/handlers/handle_chat_socket.py:77",
            "showInDiagram": true,
            "order_no": 4
          },
          {
            "id": "op-bind",
            "title": "tool_bind_shipment_overview",
            "description": "Binds the shipment tool to this connection's user, once. app/features/feature_chat/handlers/handle_chat_socket.py:82\n→ call tool_bind_shipment_overview (bind tool to user)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:82  tools = [tool_bind_shipment_overview(user)]",
            "showInDiagram": true,
            "order_no": 5
          },
          {
            "id": "op-recv",
            "title": "websocket.receive_json",
            "description": "Loop: reads the next message; malformed ones get an error event. app/features/feature_chat/handlers/handle_chat_socket.py:88",
            "showInDiagram": true,
            "order_no": 6
          },
          {
            "id": "op-retrieve",
            "title": "service_retrieve_chunks",
            "description": "Retrieves up to retrieval_top_k chunks the user may read. app/features/feature_chat/handlers/handle_chat_socket.py:101\n→ await service_retrieve_chunks (retrieve allowed chunks)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:101  chunks = await service_retrieve_chunks(message.text, user, embedder, store, settings.retrieval_top_k)",
            "showInDiagram": true,
            "order_no": 7
          },
          {
            "id": "op-sources",
            "title": "websocket.send_json",
            "description": "Sends a sources event with the deduplicated (file, page) pairs. app/features/feature_chat/handlers/handle_chat_socket.py:104",
            "showInDiagram": true,
            "order_no": 8
          },
          {
            "id": "op-prompt",
            "title": "service_build_prompt",
            "description": "Builds rules + labelled allowed passages. app/features/feature_chat/handlers/handle_chat_socket.py:106\n→ call service_build_prompt (build prompt)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:106  system_prompt = service_build_prompt(chunks)",
            "showInDiagram": true,
            "order_no": 9
          },
          {
            "id": "op-answer",
            "title": "service_stream_answer",
            "description": "Streams the LLM answer for the prompt, the question and the bound tools. app/features/feature_chat/handlers/handle_chat_socket.py:108\n→ await service_stream_answer (stream answer (with tools))\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:108  async for piece in service_stream_answer(system_prompt, message.text, llm, tools):",
            "showInDiagram": true,
            "order_no": 10
          },
          {
            "id": "op-stream",
            "title": "websocket.send_json",
            "description": "Sends each piece as a stream event. app/features/feature_chat/handlers/handle_chat_socket.py:109",
            "showInDiagram": true,
            "order_no": 11
          },
          {
            "id": "op-done",
            "title": "websocket.send_json",
            "description": "Sends done after the last piece. app/features/feature_chat/handlers/handle_chat_socket.py:110",
            "showInDiagram": true,
            "order_no": 12
          },
          {
            "id": "op-use-clientmessage",
            "title": "ClientMessage",
            "description": "Calls ClientMessage (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:54\n→ call ClientMessage (calls ClientMessage)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:54  first = ClientMessage(**await websocket.receive_json())",
            "showInDiagram": true,
            "order_no": 13
          },
          {
            "id": "op-use-authfailedevent",
            "title": "AuthFailedEvent",
            "description": "Calls AuthFailedEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:60\n→ call AuthFailedEvent (calls AuthFailedEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:60  await websocket.send_json(AuthFailedEvent(message=\"first message must be an auth message\").model_dump())",
            "showInDiagram": true,
            "order_no": 14
          },
          {
            "id": "op-use-authsuccessevent",
            "title": "AuthSuccessEvent",
            "description": "Calls AuthSuccessEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:77\n→ call AuthSuccessEvent (calls AuthSuccessEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:77  AuthSuccessEvent(user_id=user.sub, name=user.name, role=user.role, clearance=user.clearance).model_dump()",
            "showInDiagram": true,
            "order_no": 15
          },
          {
            "id": "op-use-errorevent",
            "title": "ErrorEvent",
            "description": "Calls ErrorEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:94\n→ call ErrorEvent (calls ErrorEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:94  await websocket.send_json(ErrorEvent(message=\"invalid message\").model_dump())",
            "showInDiagram": true,
            "order_no": 16
          },
          {
            "id": "op-use-sourcesevent",
            "title": "SourcesEvent",
            "description": "Calls SourcesEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:104\n→ call SourcesEvent (calls SourcesEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:104  await websocket.send_json(SourcesEvent(sources=[SourceRef(source_file=f, page=p) for f, p in pages]).model_dump())",
            "showInDiagram": true,
            "order_no": 17
          },
          {
            "id": "op-use-sourceref",
            "title": "SourceRef",
            "description": "Calls SourceRef (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:104\n→ call SourceRef (calls SourceRef)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:104  await websocket.send_json(SourcesEvent(sources=[SourceRef(source_file=f, page=p) for f, p in pages]).model_dump())",
            "showInDiagram": true,
            "order_no": 18
          },
          {
