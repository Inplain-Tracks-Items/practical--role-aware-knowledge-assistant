    {
      "path": "process_executor_canvas/crd-role-aware-knowledge-assistant-s2-be-handle-chat-socket",
      "data": {
        "name": "handle_chat_socket",
        "input": [
          {
            "id": "in-ws",
            "name": "websocket",
            "description": "WebSocket, from the door.",
            "order_no": 1
          },
          {
            "id": "in-settings",
            "name": "settings",
            "description": "Settings, from the door. Used for JWT verification.",
            "order_no": 2
          },
          {
            "id": "in-llm",
            "name": "llm",
            "description": "LLMProvider, from the door.",
            "order_no": 3
          },
          {
            "id": "in-auth",
            "name": "message.auth",
            "description": "First client message {type: \"auth\", token}.",
            "order_no": 4
          },
          {
            "id": "in-msg",
            "name": "message.question",
            "description": "Later client messages {type: \"message\", text}.",
            "order_no": 5
          }
        ],
        "validations": [
          {
            "id": "val-in-auth",
            "inputId": "in-auth",
            "rules": [
              "must parse as ClientMessage, else auth_failed + close",
              "type == \"auth\" and token present, else auth_failed + close",
              "verify_jwt must succeed, else auth_failed with the AuthError message + close"
            ],
            "order_no": 1
          },
          {
            "id": "val-in-msg",
            "inputId": "in-msg",
            "rules": [
              "must parse as ClientMessage, else error event \"invalid message\" and the loop continues",
              "type == \"message\" and text not empty, else ignored"
            ],
            "order_no": 2
          }
        ],
        "operation": [
          {
            "id": "op-accept",
            "title": "websocket.accept",
            "description": "Accepts the connection. app/features/feature_chat/handlers/handle_chat_socket.py:34",
            "showInDiagram": true,
            "order_no": 1
          },
          {
            "id": "op-recv-auth",
            "title": "websocket.receive_json",
            "description": "Reads the first message and parses it as ClientMessage. app/features/feature_chat/handlers/handle_chat_socket.py:38",
            "showInDiagram": true,
            "order_no": 2
          },
          {
            "id": "op-verify",
            "title": "verify_jwt",
            "description": "Verifies the token; the returned TokenClaims are the connection's identity. app/features/feature_chat/handlers/handle_chat_socket.py:54\n→ call verify_jwt (verify token)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:54  user = verify_jwt(first.token, settings)",
            "showInDiagram": true,
            "order_no": 3
          },
          {
            "id": "op-auth-ok",
            "title": "websocket.send_json",
            "description": "Sends auth_success with user_id, name, role, clearance. app/features/feature_chat/handlers/handle_chat_socket.py:61",
            "showInDiagram": true,
            "order_no": 4
          },
          {
            "id": "op-recv",
            "title": "websocket.receive_json",
            "description": "Loop: reads the next message; malformed ones get an error event. app/features/feature_chat/handlers/handle_chat_socket.py:68",
            "showInDiagram": true,
            "order_no": 5
          },
          {
            "id": "op-answer",
            "title": "service_stream_answer",
            "description": "Streams the answer to the question. app/features/feature_chat/handlers/handle_chat_socket.py:80\n→ await service_stream_answer (stream answer)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:80  async for piece in service_stream_answer(message.text, llm):",
            "showInDiagram": true,
            "order_no": 6
          },
          {
            "id": "op-stream",
            "title": "websocket.send_json",
            "description": "Sends each piece as a stream event. app/features/feature_chat/handlers/handle_chat_socket.py:81",
            "showInDiagram": true,
            "order_no": 7
          },
          {
            "id": "op-done",
            "title": "websocket.send_json",
            "description": "Sends done after the last piece. app/features/feature_chat/handlers/handle_chat_socket.py:82",
            "showInDiagram": true,
            "order_no": 8
          },
          {
            "id": "op-use-clientmessage",
            "title": "ClientMessage",
            "description": "Calls ClientMessage (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:38\n→ call ClientMessage (calls ClientMessage)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:38  first = ClientMessage(**await websocket.receive_json())",
            "showInDiagram": true,
            "order_no": 9
          },
          {
            "id": "op-use-authfailedevent",
            "title": "AuthFailedEvent",
            "description": "Calls AuthFailedEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:44\n→ call AuthFailedEvent (calls AuthFailedEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:44  await websocket.send_json(AuthFailedEvent(message=\"first message must be an auth message\").model_dump())",
            "showInDiagram": true,
            "order_no": 10
          },
          {
            "id": "op-use-authsuccessevent",
            "title": "AuthSuccessEvent",
            "description": "Calls AuthSuccessEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:61\n→ call AuthSuccessEvent (calls AuthSuccessEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:61  AuthSuccessEvent(user_id=user.sub, name=user.name, role=user.role, clearance=user.clearance).model_dump()",
            "showInDiagram": true,
            "order_no": 11
          },
          {
            "id": "op-use-errorevent",
            "title": "ErrorEvent",
            "description": "Calls ErrorEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:74\n→ call ErrorEvent (calls ErrorEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:74  await websocket.send_json(ErrorEvent(message=\"invalid message\").model_dump())",
            "showInDiagram": true,
            "order_no": 12
          },
          {
            "id": "op-use-streamevent",
            "title": "StreamEvent",
            "description": "Calls StreamEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:81\n→ call StreamEvent (calls StreamEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:81  await websocket.send_json(StreamEvent(text=piece).model_dump())",
            "showInDiagram": true,
            "order_no": 13
          },
          {
            "id": "op-use-doneevent",
            "title": "DoneEvent",
            "description": "Calls DoneEvent (app.features.feature_chat.schemas.chat_schemas). app/features/feature_chat/handlers/handle_chat_socket.py:82\n→ call DoneEvent (calls DoneEvent)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:82  await websocket.send_json(DoneEvent().model_dump())",
            "showInDiagram": true,
            "order_no": 14
          }
        ],
        "output": [
          {
            "id": "out-auth-success",
            "name": "event.auth_success",
            "description": "{type, user_id, name, role, clearance}.",
            "order_no": 1
          },
          {
            "id": "out-auth-failed",
            "name": "event.auth_failed",
            "description": "{type, message}; the socket is closed afterwards.",
            "order_no": 2
          },
          {
            "id": "out-stream",
            "name": "event.stream",
            "description": "{type, text}, one per answer piece.",
            "order_no": 3
          },
          {
            "id": "out-done",
            "name": "event.done",
            "description": "{type} after each answer.",
            "order_no": 4
          },
          {
            "id": "out-error",
            "name": "event.error",
            "description": "{type, message} for a malformed message; the connection stays open.",
            "order_no": 5
          }
        ],
        "attributes": [
          {
            "id": "attr-description",
            "key": "description",
            "value": "Runs one chat connection: accept, auth handshake with a JWT, then a loop that streams an answer to every question."
          },
          {
            "id": "attr-crd_id",
            "key": "crd_id",
            "value": "be.handle_chat_socket"
          },
          {
            "id": "attr-kind",
            "key": "kind",
            "value": "function"
          },
          {
            "id": "attr-side",
            "key": "side",
            "value": "backend"
          },
          {
            "id": "attr-layer",
            "key": "layer",
            "value": "handler"
          },
          {
            "id": "attr-owner",
            "key": "owner",
            "value": "feature_chat"
          },
          {
            "id": "attr-source_file",
            "key": "source_file",
            "value": "app/features/feature_chat/handlers/handle_chat_socket.py"
          },
          {
            "id": "attr-qualified_symbol",
            "key": "qualified_symbol",
            "value": "app.features.feature_chat.handlers.handle_chat_socket.handle_chat_socket"
          },
          {
            "id": "attr-lines",
            "key": "lines",
            "value": "25-85"
          },
          {
            "id": "attr-component_reason",
            "key": "component_reason",
            "value": "Orchestrates the whole WebSocket lifecycle; first code with responsibility after the door."
          },
          {
            "id": "attr-status",
            "key": "status",
            "value": "observed"
          },
          {
            "id": "attr-step_change",
            "key": "step_change",
            "value": "unchanged"
          },
          {
            "id": "attr-is_async",
            "key": "is_async",
            "value": true
          }
        ]
      }
    },
    {
      "path": "process_executor_canvas/crd-role-aware-knowledge-assistant-s2-be-verify-jwt",
      "data": {
        "name": "verify_jwt",
        "input": [
          {
            "id": "in-token",
            "name": "token",
            "description": "str, required. Raw JWT from the auth message.",
            "order_no": 1
          },
          {
            "id": "in-settings",
            "name": "settings",
            "description": "Settings, required. jwt_secret and jwt_algorithm.",
            "order_no": 2
          }
        ],
        "validations": [
          {
            "id": "val-in-token",
            "inputId": "in-token",
            "rules": [
              "signature valid and algorithm in [jwt_algorithm], else AuthError(\"invalid token\")",
              "exp in the future, else AuthError(\"token expired\")",
              "claims match TokenClaims (role in Role, clearance in Clearance), else AuthError(\"token claims are incomplete or unknown\")"
            ],
            "order_no": 1
          }
        ],
        "operation": [
          {
            "id": "op-decode",
            "title": "jwt.decode",
            "description": "Checks signature and expiry with the pinned algorithm. app/core/verify_jwt.py:27\n→ call PyJWT (verify)\nEvidence: app/core/verify_jwt.py:27  payload = jwt.decode(token, settings.jwt_secret, algorithms=[settings.jwt_algorithm])",
            "showInDiagram": true,
            "order_no": 1
          },
          {
            "id": "op-claims",
            "title": "TokenClaims",
            "description": "Validates the payload into TokenClaims. app/core/verify_jwt.py:38\n→ call TokenClaims (calls TokenClaims)\nEvidence: app/core/verify_jwt.py:38  return TokenClaims(**payload)",
            "showInDiagram": true,
            "order_no": 2
          },
          {
            "id": "op-use-autherror",
            "title": "AuthError",
            "description": "Calls AuthError (app.core.auth_error). app/core/verify_jwt.py:30\n→ call AuthError (calls AuthError)\nEvidence: app/core/verify_jwt.py:30  raise AuthError(\"token expired\")",
            "showInDiagram": true,
            "order_no": 3
          }
        ],
        "output": [
          {
            "id": "out-claims",
            "name": "TokenClaims",
            "description": "sub, email, name, role, clearance.",
            "order_no": 1
          },
          {
            "id": "out-error",
            "name": "error.AuthError",
            "description": "\"token expired\", \"invalid token\" or \"token claims are incomplete or unknown\".",
            "order_no": 2
          }
        ],
        "attributes": [
          {
            "id": "attr-description",
            "key": "description",
            "value": "Verifies a JWT's signature and expiry and validates its claims into TokenClaims."
          },
          {
            "id": "attr-crd_id",
            "key": "crd_id",
            "value": "be.verify_jwt"
          },
          {
            "id": "attr-kind",
            "key": "kind",
            "value": "function"
          },
          {
            "id": "attr-side",
            "key": "side",
            "value": "backend"
          },
          {
            "id": "attr-layer",
            "key": "layer",
            "value": "service"
          },
          {
            "id": "attr-owner",
            "key": "owner",
            "value": "core"
          },
          {
            "id": "attr-source_file",
            "key": "source_file",
            "value": "app/core/verify_jwt.py"
          },
          {
            "id": "attr-qualified_symbol",
            "key": "qualified_symbol",
            "value": "app.core.verify_jwt.verify_jwt"
          },
          {
            "id": "attr-lines",
            "key": "lines",
            "value": "16-40"
          },
          {
            "id": "attr-component_reason",
            "key": "component_reason",
            "value": "The single trust decision for tokens; shared in core/ because it is not owned by one feature."
          },
          {
            "id": "attr-status",
            "key": "status",
            "value": "observed"
          },
          {
            "id": "attr-step_change",
            "key": "step_change",
            "value": "unchanged"
