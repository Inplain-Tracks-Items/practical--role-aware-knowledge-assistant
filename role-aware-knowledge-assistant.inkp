    {
      "path": "process_executor_canvas/crd-role-aware-knowledge-assistant-s3-be-handle-chat-socket",
      "data": {
        "name": "handle_chat_socket",
        "input": [
          {
            "id": "in-ws",
            "name": "websocket",
            "description": "WebSocket, from the door.",
            "order_no": 1
          },
          {
            "id": "in-settings",
            "name": "settings",
            "description": "Settings, from the door. JWT verification and retrieval_top_k.",
            "order_no": 2
          },
          {
            "id": "in-llm",
            "name": "llm",
            "description": "LLMProvider, from the door.",
            "order_no": 3
          },
          {
            "id": "in-embedder",
            "name": "embedder",
            "description": "EmbeddingProvider, from the door.",
            "order_no": 4
          },
          {
            "id": "in-store",
            "name": "store",
            "description": "VectorStore, from the door.",
            "order_no": 5
          },
          {
            "id": "in-auth",
            "name": "message.auth",
            "description": "First client message {type: \"auth\", token}.",
            "order_no": 6
          },
          {
            "id": "in-msg",
            "name": "message.question",
            "description": "Later client messages {type: \"message\", text}.",
            "order_no": 7
          }
        ],
        "validations": [
          {
            "id": "val-in-auth",
            "inputId": "in-auth",
            "rules": [
              "must parse as ClientMessage, else auth_failed + close",
              "type == \"auth\" and token present, else auth_failed + close",
              "verify_jwt must succeed, else auth_failed with the AuthError message + close"
            ],
            "order_no": 1
          },
          {
            "id": "val-in-msg",
            "inputId": "in-msg",
            "rules": [
              "must parse as ClientMessage, else error event \"invalid message\" and the loop continues",
              "type == \"message\" and text not empty, else ignored"
            ],
            "order_no": 2
          }
        ],
        "operation": [
          {
            "id": "op-accept",
            "title": "websocket.accept",
            "description": "Accepts the connection. app/features/feature_chat/handlers/handle_chat_socket.py:46",
            "showInDiagram": true,
            "order_no": 1
          },
          {
            "id": "op-recv-auth",
            "title": "websocket.receive_json",
            "description": "Reads the first message and parses it as ClientMessage. app/features/feature_chat/handlers/handle_chat_socket.py:50",
            "showInDiagram": true,
            "order_no": 2
          },
          {
            "id": "op-verify",
            "title": "verify_jwt",
            "description": "Verifies the token; the returned TokenClaims are the connection's identity. app/features/feature_chat/handlers/handle_chat_socket.py:66\n→ call verify_jwt (verify token)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:66  user = verify_jwt(first.token, settings)",
            "showInDiagram": true,
            "order_no": 3
          },
          {
            "id": "op-auth-ok",
            "title": "websocket.send_json",
            "description": "Sends auth_success with user_id, name, role, clearance. app/features/feature_chat/handlers/handle_chat_socket.py:73",
            "showInDiagram": true,
            "order_no": 4
          },
          {
            "id": "op-recv",
            "title": "websocket.receive_json",
            "description": "Loop: reads the next message; malformed ones get an error event. app/features/feature_chat/handlers/handle_chat_socket.py:80",
            "showInDiagram": true,
            "order_no": 5
          },
          {
            "id": "op-retrieve",
            "title": "service_retrieve_chunks",
            "description": "Retrieves up to retrieval_top_k chunks the user may read. app/features/feature_chat/handlers/handle_chat_socket.py:93\n→ await service_retrieve_chunks (retrieve allowed chunks)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:93  chunks = await service_retrieve_chunks(message.text, user, embedder, store, settings.retrieval_top_k)",
            "showInDiagram": true,
            "order_no": 6
          },
          {
            "id": "op-sources",
            "title": "websocket.send_json",
            "description": "Sends a sources event with the deduplicated (file, page) pairs. app/features/feature_chat/handlers/handle_chat_socket.py:96",
            "showInDiagram": true,
            "order_no": 7
          },
          {
            "id": "op-answer",
            "title": "service_stream_answer",
            "description": "Streams the answer to the question. app/features/feature_chat/handlers/handle_chat_socket.py:98\n→ await service_stream_answer (stream answer)\nEvidence: app/features/feature_chat/handlers/handle_chat_socket.py:98  async for piece in service_stream_answer(message.text, llm):",
            "showInDiagram": true,
            "order_no": 8
          },
          {
            "id": "op-stream",
            "title": "websocket.send_json",
            "description": "Sends each piece as a stream event. app/features/feature_chat/handlers/handle_chat_socket.py:99",
            "showInDiagram": true,
            "order_no": 9
          },
          {
            "id": "op-done",
            "title": "websocket.send_json",
            "description": "Sends done after the last piece. app/features/feature_chat/handlers/handle_chat_socket.py:100",
            "showInDiagram": true,
            "order_no": 10
          }
        ],
        "output": [
          {
            "id": "out-auth-success",
            "name": "event.auth_success",
            "description": "{type, user_id, name, role, clearance}.",
            "order_no": 1
          },
          {
            "id": "out-auth-failed",
            "name": "event.auth_failed",
            "description": "{type, message}; the socket is closed afterwards.",
            "order_no": 2
          },
          {
            "id": "out-sources",
            "name": "event.sources",
            "description": "{type, sources: [{source_file, page}]} before each answer; allowed pages only.",
            "order_no": 3
          },
          {
            "id": "out-stream",
            "name": "event.stream",
            "description": "{type, text}, one per answer piece.",
            "order_no": 4
          },
          {
            "id": "out-done",
            "name": "event.done",
            "description": "{type} after each answer.",
            "order_no": 5
          },
          {
            "id": "out-error",
            "name": "event.error",
            "description": "{type, message} for a malformed message; the connection stays open.",
            "order_no": 6
          }
        ],
        "attributes": [
          {
            "id": "attr-description",
            "key": "description",
            "value": "Runs one chat connection: accept, auth handshake with a JWT, then a loop that streams an answer to every question."
          },
          {
            "id": "attr-crd_id",
            "key": "crd_id",
            "value": "be.handle_chat_socket"
          },
          {
            "id": "attr-kind",
            "key": "kind",
            "value": "function"
          },
          {
            "id": "attr-side",
            "key": "side",
            "value": "backend"
          },
          {
            "id": "attr-layer",
            "key": "layer",
            "value": "handler"
          },
          {
            "id": "attr-owner",
            "key": "owner",
            "value": "feature_chat"
          },
          {
            "id": "attr-source_file",
            "key": "source_file",
            "value": "app/features/feature_chat/handlers/handle_chat_socket.py"
          },
          {
            "id": "attr-qualified_symbol",
            "key": "qualified_symbol",
            "value": "app.features.feature_chat.handlers.handle_chat_socket.handle_chat_socket"
          },
          {
            "id": "attr-lines",
            "key": "lines",
            "value": "30-103"
          },
          {
            "id": "attr-component_reason",
            "key": "component_reason",
            "value": "Orchestrates the whole WebSocket lifecycle; first code with responsibility after the door."
          },
          {
            "id": "attr-status",
            "key": "status",
            "value": "observed"
          },
          {
            "id": "attr-step_change",
            "key": "step_change",
            "value": "changed"
          },
          {
            "id": "attr-is_async",
            "key": "is_async",
            "value": true
          },
          {
            "id": "attr-step_note",
            "key": "step_note",
            "value": "retrieves the allowed chunks for each question and sends a sources event before the answer"
