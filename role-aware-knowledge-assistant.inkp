          }
        ],
        "validations": [],
        "operation": [
          {
            "id": "op-dep-llm",
            "title": "get_llm_provider",
            "description": "FastAPI resolves Depends(get_llm_provider) before the door runs: the shared LLM provider. app/features/feature_chat/router.py:22\n→ call get_llm_provider (injected via Depends)\nEvidence: app/features/feature_chat/router.py:22  llm=Depends(get_llm_provider),",
            "showInDiagram": true,
            "order_no": 1
          },
          {
            "id": "op-dep-embedder",
            "title": "get_embedder",
            "description": "FastAPI resolves Depends(get_embedder): the shared embedding provider. app/features/feature_chat/router.py:23\n→ call get_embedder (injected via Depends)\nEvidence: app/features/feature_chat/router.py:23  embedder=Depends(get_embedder),",
            "showInDiagram": true,
            "order_no": 2
          },
          {
            "id": "op-dep-store",
            "title": "get_vectorstore",
            "description": "FastAPI resolves Depends(get_vectorstore): the shared Chroma store. app/features/feature_chat/router.py:24\n→ call get_vectorstore (injected via Depends)\nEvidence: app/features/feature_chat/router.py:24  store=Depends(get_vectorstore),",
            "showInDiagram": true,
            "order_no": 3
          },
          {
            "id": "op-delegate",
            "title": "handle_chat_socket",
            "description": "Passes the socket and the four dependencies through. app/features/feature_chat/router.py:27\n→ await handle_chat_socket (delegates)\nEvidence: app/features/feature_chat/router.py:27  await handle_chat_socket(websocket, settings, llm, embedder, store)",
