      "path": "process_executor_canvas/crd-role-aware-knowledge-assistant-s3-be-handle-ingest-documents",
      "data": {
        "name": "handle_ingest_documents",
        "input": [
          {
            "id": "in-dir",
            "name": "docs_dir",
            "description": "Path, required. Folder with the PDFs.",
            "order_no": 1
          },
          {
            "id": "in-size",
            "name": "chunk_size_words",
            "description": "int, required. From settings (default 120).",
            "order_no": 2
          },
          {
            "id": "in-overlap",
            "name": "chunk_overlap_words",
            "description": "int, required. From settings (default 30).",
            "order_no": 3
          },
          {
            "id": "in-embedder",
            "name": "embedder",
            "description": "EmbeddingProvider, injected.",
            "order_no": 4
          },
          {
