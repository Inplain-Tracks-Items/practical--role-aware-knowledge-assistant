                  "showInDiagram": true,
                  "order_no": 4
                },
                {
                  "id": "op-run",
                  "title": "_run_tool",
                  "description": "Runs all requested tools with asyncio.gather; unknown names and bad JSON become error results. app/providers/llm/openai_provider.py:86\n→ concurrent get_shipment_overview (parallel: requested tools)\nEvidence: app/providers/llm/openai_provider.py:86  results = await asyncio.gather(*(self._run_tool(tool_map, c) for c in requested))",
                  "showInDiagram": true,
                  "order_no": 5
                },
                {
                  "id": "op-results",
                  "title": "inline: tool messages",
                  "description": "Appends one {role: tool} message per result for the next round. app/providers/llm/openai_provider.py:88",
                  "showInDiagram": true,
                  "order_no": 6
                }
