              "operationSteps": [
                {
                  "id": "op-loop",
                  "title": "inline: for user in DEMO_USERS",
                  "description": "Loops over the five demo users from configs/demo_users.py. app/features/feature_auth/handlers/handle_mint_demo_tokens.py:16",
                  "showInDiagram": true,
                  "order_no": 1
                },
                {
                  "id": "op-sign",
                  "title": "service_mint_token",
                  "description": "Signs one token per user inside the list comprehension. app/features/feature_auth/handlers/handle_mint_demo_tokens.py:16\n→ call service_mint_token (sign token)\nEvidence: app/features/feature_auth/handlers/handle_mint_demo_tokens.py:16  return [{\"user\": user, \"token\": service_mint_token(user, settings)} for user in DEMO_USERS]",
                  "showInDiagram": true,
                  "order_no": 2
                }
              ],
